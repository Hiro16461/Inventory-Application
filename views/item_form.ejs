<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <main>
    <a href="/">← Back to Home</a>
    <h1><%= title %></h1>

    <% if (locals.errorMessage) { %>
      <p style="color: red;"><%= errorMessage %></p>
    <% } %>

    <!-- Form action dynamically changes depending on whether we are creating or updating -->
    <form action="<%= item ? `/item/${item.id}/update` : '/item/create' %>" method="POST">
      
      <div>
        <label for="name">Item Name:</label>
        <input type="text" id="name" name="name" value="<%= item ? item.name : '' %>" required>
      </div>

      <div>
        <label for="description">Description:</label>
        <textarea id="description" name="description"><%= item ? item.description : '' %></textarea>
      </div>

      <div>
        <label for="price">Price ($):</label>
        <input type="number" step="0.01" id="price" name="price" value="<%= item ? item.price : '' %>" required min="0">
      </div>

      <div>
        <label for="stock_count">Stock Count:</label>
        <input type="number" id="stock_count" name="stock_count" value="<%= item ? item.stock_count : '' %>" required min="0">
      </div>

      <div>
        <label for="category_id">Category:</label>
        <select id="category_id" name="category_id" required>
          <% categories.forEach(category => { %>
            <option value="<%= category.id %>" 
              <%= item && item.category_id === category.id ? 'selected' : '' %>>
              <%= category.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <% if (item) { %>
        <div>
          <label for="admin_password">Admin Password (Required for Update):</label>
          <input type="password" id="admin_password" name="admin_password" required>
        </div>
      <% } %>

      <button type="submit">Submit</button>
    </form>
  </main>
</body>
</html>